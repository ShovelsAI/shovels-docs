{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Shovels Documentation",
  "colors": {
    "primary": "#01654D",
    "light": "#E8BD51",
    "dark": "#01654D"
  },
  "background": {
    "color": {
      "light": "#fcfbf8",
      "dark": "#101727"
    }
  },
  "fonts": {
    "heading": {
      "family": "Poppins"
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "css-variables",
        "dark": "css-variables"
      }
    }
  },
  "favicon": "/assets/favicon.png",
  "logo": {
    "light": "/assets/shovels-logo.png",
    "dark": "/assets/shovels-logo-dark.png",
    "href": "https://www.shovels.ai"
  },
  "navbar": {
    "links": [
      {
        "label": "Contact Support",
        "href": "mailto:support@shovels.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Free Trial",
      "href": "https://app.shovels.ai/login?mode=register"
    }
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/Nypja3cKDx",
      "github": "https://github.com/shovelsai",
      "linkedin": "https://linkedin.com/company/shovels"
    }
  },
  "seo": {
    "metatags": {
      "og:site_name": "Shovels Documentation",
      "og:type": "website",
      "og:image": "https://docs.shovels.ai/assets/shovels-logo.png",
      "twitter:card": "summary_large_image",
      "twitter:site": "@shovelsai"
    },
    "indexing": "navigable"
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "java",
        "go",
        "ruby",
        "php"
      ]
    },
    "mdx": {
      "server": "https://api.shovels.ai/v2"
    }
  },
  "redirects": [
    {
      "source": "/docs/knowledge-base/getting-started/charlie-ai",
      "destination": "/docs/knowledge-base/shovels-online/charlie"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "docs/introduction"
